# =============================================================================
# Poste.io Mail Server - Variables de Entorno
# =============================================================================
# Copia este archivo a .env y ajusta los valores antes de desplegar
#   cp .env.example .env
# =============================================================================

# Zona horaria
TZ=America/Lima

# Hostname del servidor de correo
MAIL_HOSTNAME=mail.canastia.pe

# Puerto alternativo para la interfaz web
# (80 y 443 están en uso por el proyecto principal)
# Solo HTTP. HTTPS lo manejará Nginx posteriormente.
WEBMAIL_HTTP_PORT=8080

# =============================================================================
# NOTAS:
#
# - Las cuentas de correo, contraseñas y toda la configuración de Poste.io
#   se gestionan desde la interfaz web (http://mail.canastia.pe:8080)
#   una vez que el contenedor esté corriendo.
#
# - Los correos, buzones y configuración se almacenan en ./data/
#   (persistente a través de recreaciones del contenedor).
#
# - Poste.io con HTTPS=OFF no maneja SSL. Nginx del proyecto principal
#   se encargará del HTTPS para mail.canastia.pe usando Let's Encrypt.
# =============================================================================
